<?xml version="1.0" encoding="utf-8"?>
<!--
  离线编译用的包源：只使用本仓库 .work\offline-feed 里从本机 NuGet 缓存导出的 .nupkg，
  避免在无外网环境里因为 nuget.org 无法访问（NU1301）而编译失败。
  正常有外网时用仓库根目录的 NuGet.config 即可。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="offline" value="..\.work\offline-feed" />
  </packageSources>
</configuration>
