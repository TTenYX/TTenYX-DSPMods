<?xml version="1.0" encoding="utf-8"?>
<!--
  包源说明
  ========
  1) nuget.org —— BepInEx / HarmonyX / UnityEngine.Modules / Mono.Cecil 等公开包，任何人可还原。

  2) offline-feed —— 可选。`DysonSphereProgram.GameLibs` 是**从游戏本体派生的包**，
     不在 nuget.org 上，也无法随仓库分发（版权 + 体积）。没有外网时，
     把本机 NuGet 缓存里的 .nupkg 导出到这个目录即可离线编译：

         powershell -NoProfile -ExecutionPolicy Bypass -File tools\export-offline-feed.ps1

     `offline-feed/` 已在 .gitignore 中，不会被提交。
     若该目录不存在，NuGet 会跳过它并从 nuget.org 还原其余包。

  有外网、且本机 NuGet 缓存里已有 GameLibs 时，直接把 <clear /> 与 offline 那两行删掉也能编译。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="offline" value="offline-feed" />
  </packageSources>
</configuration>
