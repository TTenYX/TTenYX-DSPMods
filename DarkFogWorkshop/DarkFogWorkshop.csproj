<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
		<OutputType>Library</OutputType>
		<RootNamespace>DarkFogWorkshop</RootNamespace>
		<AssemblyName>DarkFogWorkshop</AssemblyName>
		<TargetFramework>netstandard2.1</TargetFramework>
		<FileAlignment>512</FileAlignment>
		<Deterministic>true</Deterministic>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<!--
		  不要把 git 修订号编进 AssemblyInformationalVersion（.NET 的默认行为）。

		  默认下 ProductVersion 形如 `1.0.0+472fdc3...`，于是**每次提交都会改变 DLL 的
		  SHA256** —— 而本项目一直用 SHA256 校验部署产物与发布包，校验值因此无谓漂移；
		  换个 git 仓库或换个目录构建，也会得到不同的哈希。

		  关掉后构建与 git 状态、绝对路径均无关：任意检出、任意路径都产出同一个 DLL。
		  版本溯源改用 git 标签（如 release-1.0.0）。
		-->
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<PackageId>DarkFogWorkshop</PackageId>
		<BepInExPluginGuid>TTenYX.DSP.DarkFogWorkshop</BepInExPluginGuid>
		<Description>Logistics stations turn science matrices into Dark Fog materials | 物流塔用科学矩阵产出黑雾材料</Description>
		<Version>1.1.1</Version>
		<Authors>TTenYX</Authors>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<DebugType>full</DebugType>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<DebugType>none</DebugType>
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.4.17" />
		<PackageReference Include="BepInEx.PluginInfoProps" Version="1.0.0" />
		<PackageReference Include="UnityEngine.Modules" Version="2022.3.53" IncludeAssets="compile" />
		<PackageReference Include="DysonSphereProgram.GameLibs" Version="0.10.35.29088-r.0" />
		<!--
		  GameLibs 故意停在 0.10.35.29088-r.0（离线源可还原）：
		  它只是编译期引用，本 MOD 使用的 API（LDB/UIItemPicker/StationStore 等）在
		  0.10.35.29131 游戏上运行完全兼容（1.0.x 即是 29088 编译、29131 运行）。
		  若确需升级到 29145，先把对应的 nupkg 放进 .work\offline-feed。
		-->
	</ItemGroup>
	<PropertyGroup>
		<ProfileDir Condition=" '$(ProfileDir)' == '' ">$(APPDATA)\r2modmanPlus-local\DysonSphereProgram\profiles\0.10.35 new</ProfileDir>
		<DeployDir Condition=" '$(DeployDir)' == '' ">$(ProfileDir)\BepInEx\plugins\TTenYX-DarkFogWorkshop</DeployDir>
	</PropertyGroup>
	<!-- 游戏运行时 dll 被占用会复制失败，只报警告不让编译失败 -->
	<Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(ProfileDir)')">
		<ItemGroup>
			<DeployFiles Include="$(TargetPath);manifest.json;README.md" />
			<DeployFiles Include="icon.png" Condition="Exists('icon.png')" />
		</ItemGroup>
		<Copy SourceFiles="@(DeployFiles)" DestinationFolder="$(DeployDir)" Retries="0" ContinueOnError="WarnAndContinue" />
		<Message Importance="high" Text="已部署到 $(DeployDir)" Condition=" '$(MSBuildLastTaskResult)' == 'true' " />
		<Message Importance="high" Text="部署失败：游戏可能正在运行，关闭游戏后重新编译即可" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
		<!-- 部署被占用时：后台拉起等待器，游戏关闭后自动完成部署（最长等 4 小时） -->
		<Exec Condition=" '$(MSBuildLastTaskResult)' != 'true' " Command='start "dfw-autodeploy" /MIN powershell -NoProfile -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)\tools\auto-deploy-wait.ps1" -TimeoutMinutes 240' />
	</Target>
</Project>
